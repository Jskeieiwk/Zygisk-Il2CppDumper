<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fitsSystemWindows="true">

    <!-- мягкое свечение в углу под логотипом -->
    <View
        android:id="@+id/glow"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-120dp"
        android:background="@drawable/glow_ring"
        android:alpha="0.65"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <!-- ЗАГОЛОВОК -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/logo_vanta"
                    android:contentDescription="logo"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VANTA"
                        android:textColor="@color/text_primary"
                        android:letterSpacing="0.35"
                        android:textStyle="bold"
                        android:textSize="30sp"/>
                    <TextView
                        android:id="@+id/ver"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v0.1 • Oxide"
                        android:textColor="@color/text_muted"
                        android:letterSpacing="0.15"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/status_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="ready"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.2"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- КАРТА STATUS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ОБЪЕКТ"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.3"
                    android:textSize="11sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oxide / HyperHug BR24"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:layout_marginTop="4dp"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke_subtle"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:text="РЕЖИМ"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp"
                            android:letterSpacing="0.3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:text="external • read-only"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:text="ВХОД"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp"
                            android:letterSpacing="0.3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:text="root • ptrace"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- КНОПКИ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="22dp">
                <Button
                    android:id="@+id/btn_start"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/btn_primary"
                    android:text="ЗАПУСТИТЬ"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:letterSpacing="0.3"
                    android:textSize="16sp"
                    android:stateListAnimator="@null"
                    android:elevation="0dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">
                    <Button
                        android:id="@+id/btn_overlay"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="52dp"
                        android:background="@drawable/btn_ghost"
                        android:text="OVERLAY"
                        android:textColor="@color/text_primary"
                        android:letterSpacing="0.25"
                        android:textSize="13sp"
                        android:stateListAnimator="@null"/>
                    <Button
                        android:id="@+id/btn_stop"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/btn_ghost"
                        android:text="СТОП"
                        android:textColor="@color/text_primary"
                        android:letterSpacing="0.25"
                        android:textSize="13sp"
                        android:stateListAnimator="@null"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ЛОГ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="КОНСОЛЬ"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:letterSpacing="0.3"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"/>
            <ScrollView
                android:id="@+id/log_scroll"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/bg_log">
                <TextView
                    android:id="@+id/log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:fontFamily="monospace"
                    android:textColor="#B8C4D6"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.3"
                    android:text=""/>
            </ScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="22dp"
                android:text="read-only external • никаких записей в память игры"
                android:textColor="@color/text_muted"
                android:textSize="11sp"/>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
