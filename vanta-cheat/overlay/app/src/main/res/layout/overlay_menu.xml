<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_menu"
    android:padding="14dp">

    <!-- HEADER (drag) -->
    <LinearLayout
        android:id="@+id/menu_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_accent"/>
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="VANTA"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.35"/>
        <ImageButton
            android:id="@+id/menu_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:background="@android:color/transparent"
            android:contentDescription="close"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_subtle"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"/>

    <!-- ВКЛАДКА: ESP -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ESP"
        android:textColor="@color/accent_glow"
        android:textSize="11sp"
        android:letterSpacing="0.35"
        android:textStyle="bold"/>

    <CheckBox android:id="@+id/chk_esp"      style="@style/VantaChk" android:text="включить"/>
    <CheckBox android:id="@+id/chk_esp_box"  style="@style/VantaChk" android:text="рамки"/>
    <CheckBox android:id="@+id/chk_esp_name" style="@style/VantaChk" android:text="ник"/>
    <CheckBox android:id="@+id/chk_esp_hp"   style="@style/VantaChk" android:text="HP-бар"/>
    <CheckBox android:id="@+id/chk_esp_dist" style="@style/VantaChk" android:text="дистанция"/>
    <CheckBox android:id="@+id/chk_esp_line" style="@style/VantaChk" android:text="snap-линии"/>
    <CheckBox android:id="@+id/chk_team"     style="@style/VantaChk" android:text="тим-чек"/>

    <TextView
        android:id="@+id/lbl_dist"
        style="@style/VantaLbl"
        android:text="дистанция: 300м"/>
    <SeekBar
        android:id="@+id/seek_dist"
        style="@style/VantaSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_subtle"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"/>

    <!-- ВКЛАДКА: AIM -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AIM"
        android:textColor="@color/accent_glow"
        android:textSize="11sp"
        android:letterSpacing="0.35"
        android:textStyle="bold"/>
    <CheckBox android:id="@+id/chk_aim"      style="@style/VantaChk" android:text="включить"/>
    <CheckBox android:id="@+id/chk_aim_head" style="@style/VantaChk" android:text="в голову"/>
    <CheckBox android:id="@+id/chk_aim_fire" style="@style/VantaChk" android:text="только при огне"/>

    <TextView
        android:id="@+id/lbl_fov"
        style="@style/VantaLbl"
        android:text="FOV: 180px"/>
    <SeekBar
        android:id="@+id/seek_fov"
        style="@style/VantaSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/lbl_smooth"
        style="@style/VantaLbl"
        android:text="плавность: 0.35"/>
    <SeekBar
        android:id="@+id/seek_smooth"
        style="@style/VantaSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="external • zero write"
        android:gravity="center"
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:letterSpacing="0.3"
        android:layout_marginTop="10dp"/>
</LinearLayout>
