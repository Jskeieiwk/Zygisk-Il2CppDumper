<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="VantaChk" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:button">@drawable/checkbox_vanta</item>
    </style>

    <style name="VantaLbl">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="VantaSeek" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/seekbar_track</item>
        <item name="android:thumb">@drawable/seekbar_thumb</item>
        <item name="android:minHeight">4dp</item>
        <item name="android:maxHeight">4dp</item>
    </style>

</resources>
