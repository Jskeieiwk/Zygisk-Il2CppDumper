#!/system/bin/sh
# vanta — self-extracting cheat loader на базе AndKittyInjector
set -e

PKG="com.catsbit.oxidesurvivalisland"
WORK="/data/local/tmp"
INJ="$WORK/vanta-inject"
GAMEDIR="/data/data/$PKG"
SO="$GAMEDIR/libvanta.so"
FLAG="$WORK/vanta.flag"

printf '\n'
printf '  ██╗   ██╗ █████╗ ███╗   ██╗████████╗ █████╗\n'
printf '  ██║   ██║██╔══██╗████╗  ██║╚══██╔══╝██╔══██╗\n'
printf '  ██║   ██║███████║██╔██╗ ██║   ██║   ███████║\n'
printf '  ╚██╗ ██╔╝██╔══██║██║╚██╗██║   ██║   ██╔══██║\n'
printf '   ╚████╔╝ ██║  ██║██║ ╚████║   ██║   ██║  ██║\n'
printf '    ╚═══╝  ╚═╝  ╚═╝╚═╝  ╚═══╝   ╚═╝  ╚═╝  ╚═╝\n'
printf '              @Cloud_Crack · OXIDE 1.20.12034\n\n'

printf 'Overlay 0/1: '
read OVERLAY
case "$OVERLAY" in
    0|нет|no|N|n) OVERLAY=0 ;;
    *)            OVERLAY=1 ;;
esac
echo "выбран overlay=$OVERLAY"

echo "[*] распаковываю..."
awk 'NR==1,/^__INJ_B64__$/{next} /^__INJ_END__$/{exit} {print}' "$0" | base64 -d > "$INJ"
mkdir -p "$GAMEDIR" 2>/dev/null
awk 'NR==1,/^__SO_B64__$/{next}  /^__SO_END__$/{exit}  {print}' "$0" | base64 -d > "$SO"
chmod 755 "$INJ" "$SO" || true
PKG_UID=$(stat -c '%u:%g' "$GAMEDIR" 2>/dev/null || echo "")
if [ -n "$PKG_UID" ]; then
    chown "$PKG_UID" "$SO" 2>/dev/null || true
fi
restorecon "$SO" 2>/dev/null || true
echo "$OVERLAY" > "$FLAG"
chmod 666 "$FLAG" || true

# игра должна быть уже запущена
PID=$(pidof "$PKG" 2>/dev/null || true)
if [ -z "$PID" ]; then
    echo
    echo "    [!] Oxide не запущен."
    echo "    Открой игру вручную, сверни в терминал и запусти vanta ещё раз."
    echo
    echo "    Enter — выйти"
    read dummy
    exit 2
fi
echo "[+] pid=$PID"

echo "[*] инжектирую libvanta.so через AndKittyInjector..."
"$INJ" --pid "$PID" --libs "$SO" --memfd 2>&1 | sed 's/^/    /'
RC=${PIPESTATUS:-$?}
echo

if [ $RC -eq 0 ]; then
    echo "[+] инжекция прошла, жду 3с для сбора логов libvanta..."
    sleep 3
    echo
    echo "=========== LOGCAT vanta-* ==========="
    logcat -d -s vanta-main,vanta-hook,vanta-plt,vanta-render,vanta-game,vanta-il2cpp,vanta-input,vanta-aim 2>&1 | tail -80
    echo "======================================"
    echo
    echo "[+] переключаю в игру через 2с"
    sleep 2
    monkey -p "$PKG" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 || true
else
    echo "[!] AndKittyInjector вернул код $RC"
fi
exit $RC

# ===================== BINARY BLOBS =====================
__INJ_B64__
@@INJ_PAYLOAD@@
__INJ_END__
__SO_B64__
@@SO_PAYLOAD@@
__SO_END__
